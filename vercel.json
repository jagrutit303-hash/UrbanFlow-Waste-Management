{
  "version": 2,
  "builds": [
    {
      "src": "*.php",
      "use": "vercel-php@0.7.2",
      "config": { "phpVersion": "8.2" }
    },
    {
      "src": "includes/*.php",
      "use": "vercel-php@0.7.2",
      "config": { "phpVersion": "8.2" }
    }
  ],
  "routes": [
    { "src": "/uploads/(.*)", "dest": "/uploads/$1" },
    { "src": "/(.*\\.php)$",  "dest": "/$1" },
    { "src": "/(.*)",         "dest": "/index.php" }
  ]
}
